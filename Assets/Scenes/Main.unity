--- !u!114 &446266757
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 446266755}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f437d3d8407c1e42bc5ded87aee5c50, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  useDefaultPanelMusic: 0
  useFade: 1
  fadeDuration: 0.25
  messageText: {fileID: 462609386}
  fallbackTypingSpeed: 0.03
  typingSpeedMultiplier: 3
  nextButton: {fileID: 1280720440}
  tuneButton: {fileID: 934642142}
  choiceButtonA: {fileID: 1079873679}
  choiceButtonB: {fileID: 1325217269}
  choiceButtonAText: {fileID: 742279183}
  choiceButtonBText: {fileID: 1950650679}
  day1Data:
    normalLines:
    - "...\u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u0439 \u0432\u044B\u043F\u0443\u0441\u043A
      \u043F\u0440\u0435\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043F\u043E
      \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u0447\u0438\u043D\u0430\u043C"
    - "\u0415\u0441\u043B\u0438 \u0432\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435
      \u043F\u043E\u043C\u0435\u0445\u0438, \u043D\u0435 \u043F\u044B\u0442\u0430\u0439\u0442\u0435\u0441\u044C
      \u043D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u0435\u0437\u043A\u043E"
    tuningLine1: "\u043E\u0431\u044A\u0435\u043A\u0442 \u0441\u0442\u0430\u0431\u0438\u043B\u0435\u043D."
    tuningLine2: "\u0444\u043E\u043A\u0443\u0441 \u043D\u0430 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438
      \u043E\u0431\u044A\u0435\u043A\u0442\u0430."
    signalRestoredLine: "\u0410\u043D\u043D\u0430! \u0410\u043D\u043D\u0430, \u043A\u0430\u043A
      \u0441\u043B\u044B\u0448\u043D\u043E?"
    choiceTextA: "\u041A\u0442\u043E-\u0442\u043E \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F \u0441\u043E \u043C\u043D\u043E\u0439?"
    choiceTextB: "\u042F \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u044E
      \u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0442\u043E, \u0447\u0435\u0433\u043E
      \u043D\u0435\u0442"
    radioReplyA: "\u0410\u043D\u043D\u0430! \u041E\u043D\u0438 \u0445\u043E\u0442\u044F\u0442
      \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u0443 \u0442\u0435\u0431\u044F
      \u0442\u0432\u043E\u0439 \u0434\u0430\u0440! \u041E\u043D\u0438 \u0443\u0436\u0435
      \u043F\u043E\u043D\u044F\u043B\u0438, \u0447\u0442\u043E \u0442\u044B \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u0430\u044F. "
    radioReplyB: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E. \u041D\u043E
      \u0442\u044B \u0432\u0435\u0434\u044C \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0448\u044C \u0441\u043B\u0443\u0448\u0430\u0442\u044C"
    extraLinesAfterReplyA:
    - "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0438\u0433\u043D\u0430\u043B\u044B
      \u043D\u0430\u0445\u043E\u0434\u044F\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0435\u0445, \u043A\u043E\u043C\u0443 \u043E\u043D\u0438 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u044B.
      \u041D\u0415 \u041F\u0415\u0419 \u0422\u0410\u0411\u041B\u0415\u0422\u041A\u0418!"
    extraLinesAfterReplyB:
    - "\u0410\u043D\u043D\u0430, \u044D\u0442\u043E \u0432\u0430\u0436\u043D\u043E.
      \u041D\u0415 \u041F\u0415\u0419 \u0422\u0410\u0411\u041B\u0415\u0422\u041A\u0418!"
    annaFinalLine: "\u0425\u043E\u0440\u043E\u0448\u043E"
    scoreA: -1
    scoreB: 1
  day2Data:
    normalLines:
    - "\u0410\u043D\u043D\u0430, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0435\u0431\u0435
      \u0431\u0443\u0434\u0435\u0442 \u0442\u0440\u0443\u0434\u043D\u0435\u0435 \u043E\u0442\u043B\u0438\u0447\u0430\u0442\u044C
      \u043F\u043E\u043C\u0435\u0445\u0438 \u043E\u0442 \u043F\u0440\u0430\u0432\u0434\u044B"
    - "\u041D\u043E \u044D\u0442\u043E \u043D\u0435 \u0437\u043D\u0430\u0447\u0438\u0442,
      \u0447\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u044B \u0437\u0434\u0435\u0441\u044C
      \u043D\u0435\u0442"
    - "\u0427\u0442..\u0441\u0438..\u043D\u0430\u043B...\u0442\u0435\u0440...\u0441\u044F.."
    tuningLine1: "\u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0439 \u0438\u043C"
    tuningLine2: "\u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438 \u0432 \u043E\u043A\u043D\u043E"
    signalRestoredLine: "\u0421\u0438\u0433\u043D\u0430\u043B \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D.
      \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439 \u0441\u043B\u0443\u0448\u0430\u0442\u044C
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0438 \u043D\u0435
      \u043F\u0435\u0440\u0435\u0431\u0438\u0432\u0430\u0439."
    choiceTextA: "\u042D\u0442\u043E \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0439
      \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442?"
    choiceTextB: "\u0414\u043E\u043A\u0442\u043E\u0440 \u041F \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043D\u0435 \u0441\u043B\u0443\u0448\u0430\u0442\u044C..."
    radioReplyA: "\u042D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u0430\u0441\u043A\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u043F\u043E\u0434 \u0437\u0430\u0431\u043E\u0442\u0443. \u0411\u043E\u043B\u044C\u043D\u043E\u0439
      \u0440\u0430\u0437\u0443\u043C \u2014 \u043E\u0447\u0435\u043D\u044C \u0443\u0434\u043E\u0431\u043D\u043E\u0435
      \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435 \u0434\u043B\u044F
      \u0447\u0443\u0436\u043E\u0439 \u0436\u0435\u0441\u0442\u043E\u043A\u043E\u0441\u0442\u0438"
    radioReplyB: "\u0420\u0430\u0437\u0432\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
      \u0441\u0442\u0430\u043B\u043E \u0431\u044B \u0442\u0430\u043A \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u043E
      \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C \u0442\u0435\u0431\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430?"
    extraLinesAfterReplyA:
    - "\u042F \u043F\u043E\u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u0435. \u0417\u0430\u043F\u043E\u043C\u043D\u0438
      \u0433\u043B\u0430\u0432\u043D\u043E\u0435: \u041D\u0415 \u041F\u0415\u0419
      \u0422\u0410\u0411\u041B\u0415\u0422\u041A\u0418!"
    extraLinesAfterReplyB:
    - "\u0410\u043D\u043D\u0430. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u041D\u0415 \u041F\u0415\u0419 \u0422\u0410\u0411\u041B\u0415\u0422\u041A\u0418!"
    - "\u0422\u044B \u0441\u0430\u043C\u0430 \u0441\u043C\u043E\u0436\u0435\u0448\u044C
      \u0441\u0435\u0431\u0435 \u043F\u043E\u043C\u043E\u0447\u044C."
    annaFinalLine: "\u0425\u043E\u0440\u043E\u0448\u043E..."
    scoreA: -1
    scoreB: 1
  day3Data:
    normalLines:
    - "\u0410\u043D\u043D\u0430, \u043F\u043E\u0441\u043B\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0439
      \u043D\u043E\u0447\u0438 \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0442\u0440\u0443\u0434\u043D\u0435\u0435 \u0434\u0435\u043B\u0430\u0442\u044C
      \u0432\u0438\u0434, \u0447\u0442\u043E \u0442\u044B \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043F\u043E\u043D\u044F\u043B\u0430."
    - "\u0422\u044B \u0443\u0436\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0434\u0430\u043B\u0435\u043A\u043E \u0437\u0430\u0448\u043B\u0430, \u0447\u0442\u043E\u0431\u044B
      \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0432\u0441\u0451
      \u044D\u0442\u043E \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0441\u0442\u044C\u044E."
    tuningLine1: "\u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438...\u0432 \u0437\u0435\u0440\u043A\u0430\u043B\u043E..."
    tuningLine2: "...\u043E\u043D\u0430 \u0441\u043B\u044B\u0448\u0438\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u043D\u043E\u0433\u043E...\u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C
      \u0434\u043E\u0437\u0438\u0440\u043E\u0432\u043A\u0443..."
    signalRestoredLine: "\u0412\u043E\u0442 \u0442\u044B \u0438 \u0441\u043D\u043E\u0432\u0430
      \u0441\u043E \u043C\u043D\u043E\u0439. \u041A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442?"
    choiceTextA: "\u0417\u0430 \u043C\u043D\u043E\u0439 \u0432\u0441\u0451 \u044D\u0442\u043E
      \u0432\u0440\u0435\u043C\u044F \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B\u0438?"
    choiceTextB: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0442\u0435\u0440\u044F\u044E \u0440\u0430\u0441\u0441\u0443\u0434\u043E\u043A.."
    radioReplyA: "\u0425\u0443\u0436\u0435 \u0432\u0441\u0435\u0433\u043E \u0442\u043E,
      \u0447\u0442\u043E \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
      \u0442\u044B \u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C
      \u0437\u0430 \u0441\u043E\u0431\u043E\u0439 \u0438\u0445 \u0433\u043B\u0430\u0437\u0430\u043C\u0438."
    radioReplyB: "\u0411\u0435\u0437\u0443\u043C\u0438\u0435 \u043D\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0438\u0437 \u043F\u0443\u0441\u0442\u043E\u0442\u044B. \u041A\u0442\u043E-\u0442\u043E
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
      \u0435\u043C\u0443 \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0444\u043E\u0440\u043C\u0443."
    extraLinesAfterReplyA:
    - "\u0422\u0435\u0431\u044F \u0432\u0435\u043B\u0438 \u043A \u044D\u0442\u043E\u043C\u0443
      \u0434\u043D\u044E \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0442\u044B \u0441\u0430\u043C\u0430 \u043D\u0430\u0437\u0432\u0430\u043B\u0430
      \u044D\u0442\u043E \u0441\u0432\u043E\u0438\u043C \u0432\u044B\u0431\u043E\u0440\u043E\u043C"
    extraLinesAfterReplyB:
    - "\u041F\u043E\u0447\u0435\u043C\u0443 \u043E\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0442\u0432\u043E\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
      \u043D\u043E \u043D\u0435 \u0442\u0432\u043E\u0438\u043C \u0433\u043E\u043B\u043E\u0441\u043E\u043C?"
    annaFinalLine: ....
    scoreA: -1
    scoreB: 1
  sfxSource: {fileID: 446266760}
  lostSignalClip: {fileID: 8300000, guid: 4d83b885eccab6b4b86e95b2a6fd2c6c, type: 3}
  tuningClip: {fileID: 8300000, guid: 53db0005126401a4ba3189db83f69e33, type: 3}
