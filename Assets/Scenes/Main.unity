  m_Script: {fileID: 11500000, guid: c11562ccdefb19a438b689745ca85103, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  useDefaultPanelMusic: 1
  useFade: 1
  fadeDuration: 0.25
  boardImage: {fileID: 956820948}
  descriptionText: {fileID: 0}
  day1Sprite: {fileID: 21300000, guid: aa2c2290ff7599c4a8a93dd5883ef98b, type: 3}
  day2Sprite: {fileID: 21300000, guid: 47d072170d61fe7478a57583778d0060, type: 3}
  day3Sprite: {fileID: 21300000, guid: 2e03da50c8af8574d83fb53ae3e43e0b, type: 3}
  day1Description: "\u041D\u0430 \u0434\u043E\u0441\u043A\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0437\u0430\u043C\u0435\u0442\u043E\u043A, \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438
    \u0438 \u043F\u0435\u0440\u0432\u044B\u0435 \u0441\u0432\u044F\u0437\u0438 \u043C\u0435\u0436\u0434\u0443
    \u043D\u0438\u043C\u0438."
  day2Description: "\u041D\u0438\u0442\u0435\u0439 \u0441\u0442\u0430\u043B\u043E
    \u0431\u043E\u043B\u044C\u0448\u0435. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0437\u0430\u043F\u0438\u0441\u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0442\u0441\u044F,
    \u0430 \u0441\u0432\u044F\u0437\u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442
    \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u0435\u0435."
  day3Description: "\u0414\u043E\u0441\u043A\u0430 \u043F\u043E\u0447\u0442\u0438
    \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0430.
    \u041F\u043E\u0432\u0441\u044E\u0434\u0443 \u0437\u0430\u043F\u0438\u0441\u0438,
    \u043A\u0440\u0443\u0433\u0438, \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u0438
    \u0431\u0435\u0441\u043F\u043E\u0440\u044F\u0434\u043E\u0447\u043D\u044B\u0435
    \u043F\u043E\u043C\u0435\u0442\u043A\u0438."
