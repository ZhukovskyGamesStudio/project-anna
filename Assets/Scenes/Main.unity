  repeatedListenLine: "\u042F \u0443\u0436\u0435 \u0441\u043B\u0443\u0448\u0430\u043B\u0430
    \u0440\u0430\u0434\u0438\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F"
