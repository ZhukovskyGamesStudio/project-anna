  creditsText: {fileID: 703196171}
  postGameScreen: {fileID: 1341908995}
  postGameDelay: 5
  firstLine: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u0441\u0435\u0431\u044F"
  mirrorLine: "\u0412 \u0442\u0432\u043E\u0435\u0439 \u0433\u043E\u043B\u043E\u0432\u0435
    \u0442\u044C\u043C\u0430. \u041E\u043D\u0438 \u043F\u0440\u0438\u0448\u043B\u0438
    \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0441\u0442\u0430\u0442\u044C \u0435\u0451
    \u043E\u0442\u0442\u0443\u0434\u0430."
  hideHint: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u0441\u043F\u0440\u044F\u0447\u044C\u0442\u0435\u0441\u044C"
  openDoorHint: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u043E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
    \u0434\u0432\u0435\u0440\u044C"
  uncertainBedLine: "\u041F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E.
    \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u044C
    \u0434\u0432\u0435\u0440\u044C."
  mirrorPromptHint: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u0432 \u0437\u0435\u0440\u043A\u0430\u043B\u043E"
  mirrorFirstCheckLine: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0443\u0436\u043D\u043E
