--- !u!114 &1828250189
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1828250187}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 124caddd2c2a8a449904ad2c3eeded82, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  useDefaultPanelMusic: 0
  useFade: 1
  fadeDuration: 0.25
  sleepImage: {fileID: 1828250190}
  sleepText: {fileID: 570214236}
  typingDelay: 0.04
  day1Slides:
  - image: {fileID: 21300000, guid: 0ca4f6276393c1f4c9555ed0b227937d, type: 3}
    textBlocks:
    - "\u0418\u043D\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u044F \u0432 \u043B\u043E\u0432\u0443\u0448\u043A\u0435\r"
    - "\u0418 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u0434\u0451\u0442
      \u043C\u0435\u043D\u044F \u0441\u043F\u0430\u0441\u0442\u0438\r"
    - "\u041D\u043E \u043F\u043E\u0442\u043E\u043C \u044F \u043D\u0430\u0445\u043E\u0436\u0443
      \u043A\u043E\u043C\u0444\u043E\u0440\u0442 \u0432 \u044D\u0442\u043E\u043C
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438\u2026"
  - image: {fileID: 21300000, guid: adfd2c0c1bb5b2e4db80ad3113342e12, type: 3}
    textBlocks:
    - "\u0412\u0435\u0434\u044C \u044F \u0431\u044B\u043B\u0430 \u0432 \u043D\u0451\u043C
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0438 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0431\u0443\u0434\u0443"
    - "\u041C\u043D\u0435 \u0431\u044B \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
      \u0443\u0439\u0442\u0438 \u0434\u0430\u043B\u0435\u043A\u043E-\u0434\u0430\u043B\u0435\u043A\u043E\u2026\r"
    - "\u0422\u0443\u0434\u0430, \u0433\u0434\u0435 \u0448\u0443\u043C\u044F\u0442
      \u0432\u043E\u043B\u043D\u044B \u0438 \u0432\u0435\u0442\u0435\u0440 \u043E\u0431\u0434\u0443\u0432\u0430\u0435\u0442
      \u043C\u043E\u0451 \u043B\u0438\u0446\u043E"
    - "\u0422\u0443\u0434\u0430, \u0433\u0434\u0435 \u0446\u0430\u0440\u044F\u0442
      \u043F\u043E\u043A\u043E\u0439 \u0438 \u0442\u0438\u0448\u0438\u043D\u0430,
      \u0433\u0434\u0435 \u0441\u043B\u044B\u0448\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u043E\u043B\u043D\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0431\u044C\u044E\u0442\u0441\u044F \u043E \u0441\u043A\u0430\u043B\u044B\u2026"
  - image: {fileID: 21300000, guid: a9332d08061a23d4d995c58fccc28a7c, type: 3}
    textBlocks:
    - "\u0418\u043B\u0438 \u043F\u0440\u043E\u0433\u0443\u043B\u044F\u0442\u044C\u0441\u044F
      \u043F\u043E \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u043C\u0443
      \u0433\u043E\u0440\u043E\u0434\u0443\r"
    - "\u0412 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043D\u0435\u0442 \u043D\u0438\u043A\u043E\u0433\u043E
      \u0438 \u043D\u0438\u0447\u0435\u0433\u043E \u043A\u0440\u043E\u043C\u0435
      \u0437\u0430\u0431\u044B\u0442\u044B\u0445 \u043C\u043E\u043D\u043E\u043B\u0438\u0442\u043E\u0432
      \u0437\u0434\u0430\u043D\u0438\u0439"
    - "\u041F\u0440\u043E\u0439\u0442\u0438\u0441\u044C \u043F\u043E \u0437\u0430\u0440\u043E\u0441\u0448\u0435\u043C\u0443
      \u0442\u0440\u0430\u0432\u043E\u0439 \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0443,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0440\u0430\u0437\u0440\u0435\u0437\u0430\u043D
      \u0442\u0440\u0435\u0449\u0438\u043D\u0430\u043C\u0438"
  - image: {fileID: 21300000, guid: b36f986ac3c77e94894b16f0c4c971d0, type: 3}
    textBlocks:
    - "\u0413\u043E\u0440\u043E\u0434, \u0433\u0434\u0435 \u044F \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u043F\u043E\u0431\u044B\u0432\u0430\u044E\u2026"
  - image: {fileID: 21300000, guid: 8cf3bde07dc2ec34bbb26e801a919987, type: 3}
    textBlocks:
    - "\u041C\u043E\u0440\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u044F
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0443\u0432\u0438\u0436\u0443\u2026"
  - image: {fileID: 21300000, guid: e7b41f10927b22e4eada45a9af7e988a, type: 3}
    textBlocks:
    - "\u0426\u0432\u0435\u0442\u044B, \u0447\u0435\u0439 \u0437\u0430\u043F\u0430\u0445
      \u044F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0443\u0437\u043D\u0430\u044E\u2026"
  - image: {fileID: 21300000, guid: f7874b93df48c5f4b87e5838100d1946, type: 3}
    textBlocks:
    - "\u0417\u0432\u0451\u0437\u0434\u044B, \u0447\u0435\u0439 \u0431\u043B\u0435\u0441\u043A
      \u043D\u0435 \u043E\u0442\u0440\u0430\u0437\u0438\u0442\u0441\u044F \u0432
      \u043C\u043E\u0438\u0445 \u0433\u043B\u0430\u0437\u0430\u0445\u2026"
  - image: {fileID: 21300000, guid: e6c4521b14546e345b8e70b1963d92e7, type: 3}
    textBlocks:
    - "\u0418\u043C\u0435\u044E \u043B\u0438 \u044F \u043F\u0440\u0430\u0432\u043E
      \u0441\u043A\u043E\u0440\u0431\u0435\u0442\u044C \u043F\u043E \u044D\u0442\u043E\u043C\u0443?"
    - "\u0418\u043C\u0435\u044E \u043B\u0438 \u044F \u043F\u0440\u0430\u0432\u043E
      \u0441\u043A\u0443\u0447\u0430\u0442\u044C \u043F\u043E \u044D\u0442\u043E\u043C\u0443?"
    - "\u0418\u043C\u0435\u044E \u043B\u0438 \u044F \u043F\u0440\u0430\u0432\u043E
      \u0433\u0440\u0443\u0441\u0442\u0438\u0442\u044C \u0438\u0437-\u0437\u0430
      \u044D\u0442\u043E\u0433\u043E?"
  - image: {fileID: 21300000, guid: 1447231a385b4c5488f91007a17fd331, type: 3}
    textBlocks:
    - "\u0412\u0441\u0451 \u0440\u0430\u0441\u043F\u043B\u044B\u0432\u0430\u0435\u0442\u0441\u044F\u2026"
  day2Slides:
  - image: {fileID: 21300000, guid: 8a8abd6716354854e80f5c29f37c6c19, type: 3}
    textBlocks:
    - "\u0422\u044B \u0438\u0445 \u0441\u043B\u044B\u0448\u0438\u0448\u044C?"
    - "\u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0442\u044B \u0438\u0445
      \u0441\u043B\u044B\u0448\u0438\u0448\u044C"
    - "\u041E\u043D\u0438 \u0432\u0438\u0434\u044F\u0442 \u0442\u0435\u0431\u044F"
  - image: {fileID: 21300000, guid: 72d6dcb9e574d0348a8e907543e86282, type: 3}
    textBlocks:
    - "\u0421\u041C\u041E\u0422\u0420\u0418."
  - image: {fileID: 21300000, guid: af8c4e17463dde444a99aea5f22117dc, type: 3}
    textBlocks:
    - "\u0421\u041C\u041E\u0422\u0420\u0418."
  - image: {fileID: 21300000, guid: ed7c04e00fffd0340880d43b45380c24, type: 3}
    textBlocks:
    - "\u0421\u041C\u041E\u0422\u0420\u0418."
  - image: {fileID: 21300000, guid: 75eeee6e064398346bca904037aa12d8, type: 3}
    textBlocks:
    - "\u0421\u041C\u041E\u0422\u0420\u0418."
  - image: {fileID: 21300000, guid: e9e17ea3f229e7449af1394ba890126f, type: 3}
    textBlocks:
    - "\u041E\u043D\u0438 \u0443\u0436\u0435 \u0440\u044F\u0434\u043E\u043C"
  day3Slides:
  - image: {fileID: 21300000, guid: 93bb1abdb1f0e9c4b9b863b6d9956a5f, type: 3}
    textBlocks:
    - "\u0413\u043E\u043B\u043E\u0441: \u0410\u043D\u043D\u0430!"
    - "\u0410\u043D\u043D\u0430: \u0427\u0442\u043E? \u041A\u0442\u043E \u0437\u0434\u0435\u0441\u044C?"
    - "\u0413\u043E\u043B\u043E\u0441: \u0410\u043D\u043D\u0430, \u0442\u044B \u0441\u043B\u044B\u0448\u0438\u0448\u044C?"
    - "\u0410\u043D\u043D\u0430: \u042D\u0442\u043E\u2026\u044F? \u041F\u043E\u0445\u043E\u0436\u0435
      \u043D\u0430 \u043C\u043E\u0439 \u0433\u043E\u043B\u043E\u0441..."
    - "\u0413\u043E\u043B\u043E\u0441: \u0410\u043D\u043D\u0430!"
    - "\u0413\u043E\u043B\u043E\u0441: \u042F \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0430\u0439\u0434\u0443 \u0442\u0435\u0431\u044F"
    - "\u0410\u043D\u043D\u0430: ..."
