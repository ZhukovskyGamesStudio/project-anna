--- !u!114 &1097641772
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1097641770}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0da582c425d18654f81632bbb3a20d1b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  useDefaultPanelMusic: 0
  useFade: 1
  fadeDuration: 0.25
  dialogueText: {fileID: 209256219}
  fallbackTypingSpeed: 0.2
  typingSpeedMultiplier: 2
  nextButton: {fileID: 2035571849}
  choiceButtonA: {fileID: 1041324069}
  choiceButtonB: {fileID: 788376325}
  choiceButtonAText: {fileID: 60831161}
  choiceButtonBText: {fileID: 1756652637}
  day1Data:
    normalLinesBeforeChoice1:
    - "\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C, \u0410\u043D\u043D\u0430.
      \u041A\u0430\u043A \u0442\u044B \u0441\u0435\u0431\u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F?"
    choiceBlock1:
      choiceTextA: "\u0420\u0430\u0434\u0438\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u043E
        \u0441\u043E \u043C\u043D\u043E\u0439. \u041E\u043D\u043E \u0437\u043D\u0430\u0435\u0442,
        \u043A\u0442\u043E \u044F."
      choiceTextB: "\u0422\u0440\u0435\u0432\u043E\u0436\u043D\u043E, \u043D\u043E
        \u044F \u0434\u0435\u0440\u0436\u0443\u0441\u044C."
      phoneReplyA: "\u041F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F
        \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
        \u044D\u0442\u043E \u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C."
      phoneReplyB: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0442\u0440\u0435\u0432\u043E\u0433\u0430
        \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442 \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0435
        \u0438 \u0434\u0435\u043B\u0430\u0435\u0442 \u043E\u0431\u044B\u0447\u043D\u044B\u0435
        \u0432\u0435\u0449\u0438 \u0431\u043E\u043B\u0435\u0435 \u0437\u043D\u0430\u0447\u0438\u043C\u044B\u043C\u0438."
      extraLinesAfterReplyA:
      - "\u042F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0432\u044B\u0448\u0443
        \u0442\u0435\u0431\u0435 \u0434\u043E\u0437\u0438\u0440\u043E\u0432\u043A\u0443,
        \u0445\u043E\u0440\u043E\u0448\u043E?"
      extraLinesAfterReplyB:
      - "\u0421\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u044C\u0441\u044F
        \u043D\u0430 \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0445 \u0434\u0435\u043B\u0430\u0445.
        \u041F\u043E\u0434\u0443\u043C\u0430\u0439, \u0447\u0435\u043C \u0445\u043E\u0442\u0435\u043B\u0430
        \u0431\u044B \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F."
      scoreA: -1
      scoreB: 1
    linesBetweenChoice1AndChoice2:
    - "\u041F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F \u043D\u0435
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u043F\u0440\u0438\u0451\u043C
      \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u043E\u0432."
    choiceBlock2:
      choiceTextA: "\u0425\u043E\u0440\u043E\u0448\u043E..."
      choiceTextB: "\u042F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C..."
      phoneReplyA: "\u0422\u043E\u0433\u0434\u0430 \u0442\u0430\u043A \u0438 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043C."
      phoneReplyB: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E!"
      extraLinesAfterReplyA:
      - "\u0414\u043E \u0437\u0430\u0432\u0442\u0440\u0430, \u0410\u043D\u043D\u0430."
      extraLinesAfterReplyB: []
      scoreA: 0
      scoreB: 0
    annaFinalLine: "\u0414\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F.."
  day2Data:
    normalLinesBeforeChoice1:
    - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, \u0410\u043D\u043D\u0430! "
    - "\u0427\u0442\u043E \u043D\u043E\u0432\u043E\u0433\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F? "
    choiceBlock1:
      choiceTextA: "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0437\u0430 \u043C\u043D\u043E\u0439 \u0441\u043B\u0435\u0434\u044F\u0442."
      choiceTextB: "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u043F\u0440\u043E\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u044E\u0442"
      phoneReplyA: "\u042F \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0447\u0442\u043E
        \u044D\u0442\u043E \u043E\u0449\u0443\u0449\u0430\u0435\u0442\u0441\u044F
        \u0440\u0435\u0430\u043B\u044C\u043D\u043E. \u0414\u0430\u0432\u0430\u0439
        \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C \u043E\u0442\u0432\u043B\u0435\u0447\u044C\u0441\u044F
        \u043E\u0442 \u044D\u0442\u043E\u0433\u043E."
      phoneReplyB: "\u0414\u0430\u0432\u0430\u0439 \u0443\u0441\u0442\u0440\u043E\u0438\u043C
        \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438."
      extraLinesAfterReplyA:
      - "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u0432\u043E\u043A\u0440\u0443\u0433
        \u0438 \u043D\u0430\u0437\u043E\u0432\u0438 \u0447\u0435\u0442\u044B\u0440\u0435
        \u0432\u0435\u0449\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u0438\u0434\u0438\u0448\u044C"
      - "\u0421\u0442\u0430\u0440\u0430\u0439\u0441\u044F \u0434\u044B\u0448\u0430\u0442\u044C
        \u0442\u0430\u043A, \u043A\u0430\u043A \u043C\u044B \u0434\u0435\u043B\u0430\u043B\u0438
        \u043D\u0430 \u043F\u0440\u0438\u0451\u043C\u0435, \u043F\u043E\u043C\u043D\u0438\u0448\u044C?"
      - "\u041E\u0442\u043B\u0438\u0447\u043D\u043E."
      extraLinesAfterReplyB:
      - "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0442\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C?"
      scoreA: -1
      scoreB: 1
    linesBetweenChoice1AndChoice2:
    - "\u041C\u043D\u0435 \u0432\u0430\u0436\u043D\u043E \u043F\u043E\u043D\u044F\u0442\u044C,
      \u043A\u0430\u043A \u044D\u0442\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0434\u043B\u044F \u0442\u0435\u0431\u044F."
    choiceBlock2:
      choiceTextA: "\u041F\u043E\u0434 \u043C\u043E\u0438\u043C \u043E\u043A\u043D\u043E\u043C
        \u043C\u0430\u0448\u0438\u043D\u0430."
      choiceTextB: "\u042F \u0441\u043B\u044B\u0448\u0430\u043B\u0430 \u043F\u0438\u0449\u0430\u043D\u0438\u0435
        \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430."
      phoneReplyA: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0442\u044B \u0432\u0438\u0434\u0438\u0448\u044C
        \u043C\u0430\u0448\u0438\u043D\u0443."
      phoneReplyB: "\u042F \u0442\u0435\u0431\u044F \u043F\u043E\u043D\u044F\u043B.
        \u0418\u043D\u043E\u0433\u0434\u0430 \u0441\u0442\u0430\u0440\u044B\u0435
        \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u044B \u0441\u0431\u043E\u044F\u0442."
      extraLinesAfterReplyA:
      - "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0437\u0430\u0448\u0442\u043E\u0440\u0438\u0442\u044C
        \u043E\u043A\u043D\u0430 \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u044C
        \u0434\u0432\u043E\u0439\u043D\u0443\u044E \u0434\u043E\u0437\u0438\u0440\u043E\u0432\u043A\u0443
        \u043D\u0430 \u043D\u043E\u0447\u044C."
      extraLinesAfterReplyB:
      - "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0435
        \u0432\u043E\u043F\u0440\u043E\u0441\u0430 \u043F\u043E\u043C\u043E\u0436\u0435\u0442
        \u0442\u0435\u0431\u0435 \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C\u0441\u044F."
      - "\u041F\u043E\u0438\u0449\u0435\u0448\u044C \u0441\u0442\u0430\u0442\u044C\u0438
        \u0432 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0435?"
      scoreA: -1
      scoreB: 1
    annaFinalLine: "\u0425\u043E\u0440\u043E\u0448\u043E..."
  day3Data:
    normalLinesBeforeChoice1:
    - "\u0410\u043D\u043D\u0430, \u044F \u043D\u0430 \u043B\u0438\u043D\u0438\u0438."
    - "\u0427\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E?"
    choiceBlock1:
      choiceTextA: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u043D\u0438
        \u043F\u0440\u0438\u0448\u043B\u0438 \u0437\u0430 \u043C\u043D\u043E\u0439."
      choiceTextB: "\u041E\u043D\u0438 \u0443\u0436\u0435 \u0437\u0434\u0435\u0441\u044C,
        \u044F \u0441\u043B\u044B\u0448\u0443."
      phoneReplyA: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0434\u0430\u0432\u0430\u0439
        \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C \u0432\u043C\u0435\u0441\u0442\u0435
        \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0432
        \u044D\u0442\u043E\u043C."
      phoneReplyB: "\u042F \u0441\u043B\u044B\u0448\u0443, \u043A\u0430\u043A \u0442\u0435\u0431\u0435
        \u0441\u0442\u0440\u0430\u0448\u043D\u043E. \u0414\u0430\u0432\u0430\u0439
        \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C \u0440\u0430\u0437\u043B\u043E\u0436\u0438\u0442\u044C
        \u043F\u043B\u0430\u043D \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
        \u043F\u043E \u0448\u0430\u0433\u0430\u043C."
      extraLinesAfterReplyA:
      - "\u0410\u043D\u043D\u0430, \u0442\u044B \u0441\u0435\u0439\u0447\u0430\u0441
        \u043E\u0434\u043D\u0430?"
      extraLinesAfterReplyB:
      - "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043B\u0435\u0434\u0438
        \u0437\u0430 \u0434\u044B\u0445\u0430\u043D\u0438\u0435\u043C."
      scoreA: -1
      scoreB: 1
    linesBetweenChoice1AndChoice2:
    - "\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C..."
    choiceBlock2:
      choiceTextA: "\u0412\u044B \u0432\u0435\u0434\u044C \u0432\u0441\u0451 \u0437\u043D\u0430\u0435\u0442\u0435,
        \u0432\u0435\u0440\u043D\u043E?"
      choiceTextB: "\u0412\u044B \u0432\u0435\u0434\u044C \u043C\u043D\u0435 \u043D\u0435
        \u0432\u0435\u0440\u0438\u0442\u0435, \u0434\u0430?"
      phoneReplyA: ...
      phoneReplyB: "\u0410\u043D\u043D\u0430..."
      extraLinesAfterReplyA: []
      extraLinesAfterReplyB: []
      scoreA: -1
      scoreB: 1
    annaFinalLine: "\u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0442\u0435\u043B\u0435\u0444\u043E\u043D"
  repeatedListenLine: "\u042F \u0443\u0436\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430
    \u0441 \u043F\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u043E\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F"
  choiceInputDelay: 0.3
