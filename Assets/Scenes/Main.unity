  nextNoteButton: {fileID: 1294145380}
  fileTitleText: {fileID: 2001768305}
  filesText: {fileID: 967868216}
  day1BrowserTabs:
  - title: "\u0424\u0430\u0440\u043C\u0430\u0446\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u044B"
    content: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438
      \u0438 \u0436\u0443\u0440\u043D\u0430\u043B\u0438\u0441\u0442\u044B \u0443\u0436\u0435
      \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442 \u0441\u043F\u043E\u0440\u044F\u0442
      \u043E \u0442\u043E\u043C, \u0433\u0434\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0433\u0440\u0430\u043D\u0438\u0446\u0430 \u043C\u0435\u0436\u0434\u0443 \u043B\u0435\u0447\u0435\u043D\u0438\u0435\u043C,
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435\u043C \u0438 \u0441\u043A\u0440\u044B\u0442\u044B\u043C
      \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435\u043C. \u0412
      \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u043F\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0438
      \u043D\u0435 \u0440\u0430\u0437 \u0441\u043B\u0443\u0447\u0430\u043B\u043E\u0441\u044C
      \u0442\u0430\u043A, \u0447\u0442\u043E \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u044B
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C \u043D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044F\u043C\u0438
      \u043F\u043E\u043C\u043E\u0449\u0438, \u043D\u043E \u0438 \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C\u0438
      \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044F. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u044B \u0441\u043B\u0443\u0447\u0430\u0438,
      \u0433\u0434\u0435 \u043B\u044E\u0434\u0438 \u043D\u0435 \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u043F\u043E\u043D\u0438\u043C\u0430\u043B\u0438, \u043A\u0430\u043A\u0438\u0435
      \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u044B \u0438\u043C \u0434\u0430\u044E\u0442,
      \u0437\u0430\u0447\u0435\u043C \u043C\u0435\u043D\u044F\u044E\u0442 \u0434\u043E\u0437\u0438\u0440\u043E\u0432\u043A\u0443
      \u0438 \u043A\u0430\u043A \u0438\u043C\u0435\u043D\u043D\u043E \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u044E\u0442
      \u0438\u0445 \u0440\u0435\u0430\u043A\u0446\u0438\u044E.\n\n\u041E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E
      \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0438
      \u0441\u0442\u0440\u043E\u0433\u043E \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u044E\u0442\u0441\u044F,
      \u043D\u043E \u044D\u0442\u043E \u043D\u0435 \u043C\u0435\u0448\u0430\u0435\u0442
      \u043F\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u044F\u043C
      \u043E \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0445 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0445,
      \u0447\u0430\u0441\u0442\u043D\u044B\u0445 \u043A\u043B\u0438\u043D\u0438\u043A\u0430\u0445
      \u0438 \u201C\u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E\u043C
      \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0438\u201D, \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u043E\u043C
      \u0432 \u0441\u043E\u043C\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u0418\u043D\u043E\u0433\u0434\u0430
      \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0441\u0442\u0440\u0430\u0445 \u0441\u0432\u044F\u0437\u0430\u043D
      \u0434\u0430\u0436\u0435 \u043D\u0435 \u0441 \u0441\u0430\u043C\u0438\u043C
      \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u043E\u043C, \u0430 \u0441
      \u0442\u0435\u043C, \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442, \u043A\u0430\u043A \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u043F\u043E\u0434 \u0435\u0433\u043E \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C."
  - title: "\u041F\u043E\u0431\u043E\u0447\u043D\u044B\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B
      \u0430\u043D\u0442\u0438\u043F\u0441\u0438\u0445\u043E\u0442\u0438\u043A\u043E\u0432"
    content: "\u0410\u043D\u0442\u0438\u043F\u0441\u0438\u0445\u043E\u0442\u0438\u043A\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0442\u044C
      \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u043F\u0441\u0438\u0445\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u043E\u0432, \u043D\u043E \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u044D\u0442\u0438\u043C \u043D\u0435\u0440\u0435\u0434\u043A\u043E
      \u0432\u044B\u0437\u044B\u0432\u0430\u044E\u0442 \u0438 \u043F\u043E\u0431\u043E\u0447\u043D\u044B\u0435
      \u044D\u0444\u0444\u0435\u043A\u0442\u044B. \u0423 \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430
      \u0442\u0430\u043A\u0438\u0445 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u043E\u0432
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442\u0441\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u043F\u043E\u0431\u043E\u0447\u043D\u044B\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B:\r\n-
      \u0441\u043E\u043D\u043B\u0438\u0432\u043E\u0441\u0442\u044C \u0438 \u0437\u0430\u0442\u043E\u0440\u043C\u043E\u0436\u0435\u043D\u043D\u043E\u0441\u0442\u044C\r\n-
      \u043F\u0440\u0438\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435 \u044D\u043C\u043E\u0446\u0438\u0439\r\n-
      \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0438 \u0441 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u0435\u0439\r\n-
      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u201C\u0442\u0443\u043C\u0430\u043D\u0430
      \u0432 \u0433\u043E\u043B\u043E\u0432\u0435\u201D\r\n- \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435
      \u043C\u0430\u0441\u0441\u044B \u0442\u0435\u043B\u0430\r\n- \u0443\u0445\u0443\u0434\u0448\u0435\u043D\u0438\u0435
      \u043F\u0430\u043C\u044F\u0442\u0438\r\n- \u0433\u043E\u043B\u043E\u0432\u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435
      \u0438 \u0442\u043E\u0448\u043D\u043E\u0442\u0430\r\n\u041D\u0435 \u0432\u0441\u0435
      \u0440\u0435\u0430\u043A\u0446\u0438\u0438 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B,
      \u043C\u043D\u043E\u0433\u043E\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442
      \u043E\u0442 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0433\u043E
      \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0430 \u0438 \u0434\u043E\u0437\u0438\u0440\u043E\u0432\u043A\u0438.
      \u0418\u043C\u0435\u043D\u043D\u043E \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0441\u043C\u0435\u043D\u0430 \u0441\u0445\u0435\u043C\u044B \u043B\u0435\u0447\u0435\u043D\u0438\u044F
      \u0431\u0435\u0437 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0433\u043E
      \u043E\u0431\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u044F \u0441 \u0432\u0440\u0430\u0447\u043E\u043C
      \u043D\u0435\u0440\u0435\u0434\u043A\u043E \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442
      \u0442\u0440\u0435\u0432\u043E\u0433\u0443. \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E
      \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u0430\u043C \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u0442\u044C
      \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430 \u043E \u043D\u0435\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u044D\u0444\u0444\u0435\u043A\u0442\u0430\u0445.\r\n"
  - title: "\u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u0440\u0430\u0432\u0434\u0443"
    content: "\u0422\u0435\u043C\u0430: \u041A\u0442\u043E \u0435\u0449\u0451 \u0434\u0443\u043C\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043D\u0430\u043C \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
      \u043D\u0435\u0434\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044E\u0442?\n\nuser_17\n\u042F
      \u0443\u0436\u0435 \u043D\u0435 \u043F\u0435\u0440\u0432\u044B\u0439 \u0433\u043E\u0434
      \u0437\u0430\u043C\u0435\u0447\u0430\u044E \u043E\u0434\u043D\u043E \u0438
      \u0442\u043E \u0436\u0435: \u043A\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
      \u0447\u0442\u043E-\u0442\u043E \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E\u0435,
      \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u044B\u0441\u0442\u0440\u043E
      \u0438 \u0437\u0432\u0443\u0447\u0438\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0433\u043B\u0430\u0434\u043A\u043E. \u041A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u0435\u0451 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0438
      \u0437\u0430\u0440\u0430\u043D\u0435\u0435. \nnorthgate\n\u041F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
      \u043F\u0440\u043E\u0449\u0435, \u0447\u0435\u043C \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C
      \u0432\u0441\u0451 \u043B\u044E\u0434\u044F\u043C. \nmilk_static\n\u0415\u0441\u0442\u044C
      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435, \u0447\u0442\u043E \u0447\u0430\u0441\u0442\u044C
      \u0434\u0430\u043D\u043D\u044B\u0445 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E
      \u0434\u0440\u043E\u0431\u044F\u0442. \nuser_17\n\u041C\u0435\u043D\u044F \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0441\u0435\u0433\u043E \u043F\u0443\u0433\u0430\u0435\u0442, \u043A\u0430\u043A
      \u0431\u044B\u0441\u0442\u0440\u043E \u043B\u044E\u0431\u043E\u0435 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0435
      \u043E\u0431\u044A\u044F\u0432\u043B\u044F\u044E\u0442 \u0431\u0440\u0435\u0434\u043E\u043C.
      \nredroom89\n\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0443
      \u043B\u044E\u0434\u0435\u0439 \u043D\u0435 \u043D\u0443\u0436\u0435\u043D
      \u043E\u0442\u0432\u0435\u0442. \u0418\u043C \u043D\u0443\u0436\u043D\u0430
      \u0432\u0435\u0440\u0441\u0438\u044F, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043C\u043E\u0436\u043D\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u0436\u0438\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435."
  day1Notes:
  - title: "\u0421\u043F\u0438\u0441\u043E\u043A \u0434\u0435\u043B.txt"
    content: "1. \u0421\u0445\u043E\u0434\u0438\u0442\u044C \u0437\u0430 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430\u043C\u0438\n2.
      \u0414\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u043A\u043D\u0438\u0433\u0443\n3.
      \u041F\u043E\u043C\u044B\u0442\u044C\u0441\u044F\n4. \u041F\u0440\u043E\u0442\u0435\u0440\u0435\u0442\u044C
      \u043F\u044B\u043B\u044C\n5. \u041D\u0435 \u0437\u0430\u0431\u044B\u0442\u044C
      \u043F\u043E\u0435\u0441\u0442\u044C\n6. \u0412\u044B\u043F\u0438\u0442\u044C
      \u0442\u0430\u0431\u043B\u0435\u0442\u043A\u0438 \u043F\u0435\u0440\u0435\u0434
      \u0441\u043D\u043E\u043C"
  day1Files:
  - title: Poetry_1.txt
    content: "\u0421\u0432\u0435\u0442 \u043B\u043E\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0438\u0437\u043B\u043E\u043C,\r\n\u0422\u0430\u044E\u0442 \u0442\u0435\u043D\u0438
      \u0432 \u0442\u0438\u0448\u0438\u043D\u0435\r\n\u041A\u0442\u043E-\u0442\u043E
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043F\u0443\u0441\u0442\u043E\u0439\r\n\u041F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B
      \u043F\u0435\u0441\u043E\u043A.\r\n\u0412\u0440\u0435\u043C\u044F \u0441\u0436\u0430\u043B\u043E\u0441\u044C
      \u0432 \u043F\u043B\u043E\u0442\u043D\u044B\u0439 \u043A\u043E\u043C\r\n\u041D\u0435
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043D\u0430\u043C \u043D\u0430\u0437\u0430\u0434\r\n\u0413\u0434\u0435-\u0442\u043E
      \u0437\u0430 \u0441\u0442\u0435\u043D\u043E\u0439 \u043F\u0440\u0438\u0431\u043E\u0439,\r\n\u041E\u043D
      \u0437\u043E\u0432\u0451\u0442 \u043C\u0435\u043D\u044F \u043A \u0441\u0435\u0431\u0435"
  day2BrowserTabs:
  - title: "\u041F\u0440\u043E\u0432\u0430\u043B\u044B \u0432 \u043F\u0430\u043C\u044F\u0442\u0438
      \u0438 \u043C\u0435\u0434\u0438\u043A\u0430\u043C\u0435\u043D\u0442\u044B"
    content: "\u041F\u0440\u043E\u0432\u0430\u043B\u044B \u0432 \u043F\u0430\u043C\u044F\u0442\u0438
      \u043C\u043E\u0433\u0443\u0442 \u043E\u0449\u0443\u0449\u0430\u0442\u044C\u0441\u044F
      \u043F\u0443\u0433\u0430\u044E\u0449\u0435: \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
      \u0437\u0430\u043F\u0438\u0441\u044C, \u043D\u043E \u043D\u0435 \u043F\u043E\u043C\u043D\u0438\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u0438 \u0437\u0430\u0447\u0435\u043C \u0435\u0451
      \u0441\u0434\u0435\u043B\u0430\u043B. \u0418\u043D\u043E\u0433\u0434\u0430
      \u044D\u0442\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u043F\u0435\u0440\u0435\u0443\u0442\u043E\u043C\u043B\u0435\u043D\u0438\u0435\u043C,
      \u0441\u0442\u0440\u0435\u0441\u0441\u043E\u043C, \u0442\u0440\u0435\u0432\u043E\u0433\u043E\u0439,
      \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435\u043C \u0441\u043D\u0430
      \u0438\u043B\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u043E\u0432.
      \u0412 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u043B\u0443\u0447\u0430\u044F\u0445
      \u043F\u0440\u0438\u0447\u0438\u043D\u043E\u0439 \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
      \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B
      \u043F\u0441\u0438\u0445\u0438\u043A\u0438, \u043A\u043E\u0433\u0434\u0430
      \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435 \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u043E\u0431\u0440\u0435\u0437\u0430\u0435\u0442 \u0447\u0430\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u043E\u0433\u043E \u043E\u043F\u044B\u0442\u0430.\n\n\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u0442\u044F\u0436\u0435\u043B\u043E \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u043D\u0435 \u0441\u0430\u043C\u0430 \u0437\u0430\u0431\u044B\u0432\u0447\u0438\u0432\u043E\u0441\u0442\u044C,
      \u0430 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u043E\u0442\u0447\u0443\u0436\u0434\u0435\u043D\u0438\u044F
      \u043E\u0442 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439. \u0415\u0441\u043B\u0438
      \u0442\u044B \u0432\u0438\u0434\u0438\u0448\u044C \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439
      \u043F\u043E\u0447\u0435\u0440\u043A, \u0441\u043B\u044B\u0448\u0438\u0448\u044C
      \u0441\u0432\u043E\u0439 \u0433\u043E\u043B\u043E\u0441 \u043D\u0430 \u0437\u0430\u043F\u0438\u0441\u0438
      \u0438\u043B\u0438 \u0447\u0438\u0442\u0430\u0435\u0448\u044C \u0444\u0440\u0430\u0437\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0442\u043E\u0447\u043D\u043E \u043D\u0435
      \u043C\u043E\u0433\u043B\u0430 \u0431\u044B \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u044C
      \u201C\u0441\u0435\u0439\u0447\u0430\u0441\u201D, \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442
      \u0447\u0443\u0432\u0441\u0442\u0432\u043E, \u0431\u0443\u0434\u0442\u043E
      \u0440\u044F\u0434\u043E\u043C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
      \u0434\u0440\u0443\u0433\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F \u0442\u0435\u0431\u044F.
      \u041D\u0430 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0441\u0430\u043C\u044B\u0439 \u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441:
      \u043F\u0430\u043C\u044F\u0442\u044C \u043F\u043E\u0434\u0432\u0435\u043B\u0430
      \u0442\u0435\u0431\u044F, \u0438\u043B\u0438 \u043A\u0442\u043E-\u0442\u043E
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0432\u043C\u0435\u0448\u0430\u043B\u0441\u044F \u0432 \u0442\u0432\u043E\u044E
      \u0436\u0438\u0437\u043D\u044C \u0442\u0430\u043A, \u0447\u0442\u043E \u043C\u0435\u0436\u0434\u0443
      \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
      \u043F\u0443\u0441\u0442\u043E\u0442\u044B?"
  - title: "\u041A\u0430\u043A \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0442\u043E
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u043F\u0440\u043E\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u044E\u0442"
    content: "\u0422\u0435\u043C\u0430: \u041D\u0435 \u0437\u043D\u0430\u044E, \u0441\u0445\u043E\u0436\u0443
      \u0441 \u0443\u043C\u0430 \u0438\u043B\u0438 \u043C\u043E\u0439 \u0442\u0435\u043B\u0435\u0444\u043E\u043D
      \u043F\u0440\u0430\u0432\u0434\u0430 \u0441\u043B\u0443\u0448\u0430\u044E\u0442\n\n\u041D\u0435
      \u0443\u0432\u0435\u0440\u0435\u043D, \u0447\u0442\u043E \u043F\u0438\u0448\u0443
      \u043F\u043E \u0430\u0434\u0440\u0435\u0441\u0443, \u043D\u043E \u0443 \u043C\u0435\u043D\u044F
      \u0443\u0436\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0434\u0435\u043B\u044C
      \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E
      \u0438\u0437-\u0437\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430.
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0431\u044B\u043B\u0438 \u043E\u0431\u044B\u0447\u043D\u044B\u0435
      \u0432\u0435\u0449\u0438: \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435
      \u0449\u0435\u043B\u0447\u043A\u0438 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
      \u0437\u0432\u043E\u043D\u043A\u0430, \u043F\u043E\u0442\u043E\u043C \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430
      \u043F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C, \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.
      \u042F \u0441\u043F\u0438\u0441\u044B\u0432\u0430\u043B \u044D\u0442\u043E
      \u043D\u0430 \u0441\u0432\u044F\u0437\u044C. \u041F\u043E\u0442\u043E\u043C
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B, \u0447\u0442\u043E \u0438\u043D\u043E\u0433\u0434\u0430
      \u0441\u043B\u044B\u0448\u0443 \u0441\u043B\u0430\u0431\u044B\u0439 \u0444\u043E\u043D\u043E\u0432\u044B\u0439
      \u0448\u0443\u043C, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u043A\u0442\u043E-\u0442\u043E
      \u0443\u0436\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0430
      \u043B\u0438\u043D\u0438\u0438.\n\u0421\u0430\u043C\u043E\u0435 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0435
      \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0437\u0436\u0435.
      \u041F\u043E\u0441\u043B\u0435 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u043E\u0432 \u043C\u043D\u0435
      \u0441\u0442\u0430\u043B\u043E \u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F,
      \u0447\u0442\u043E \u0440\u0435\u043A\u043B\u0430\u043C\u0430, \u043F\u0438\u0441\u044C\u043C\u0430
      \u0438 \u0434\u0430\u0436\u0435 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0435
      \u0442\u0435\u043C\u044B \u0432 \u043B\u0435\u043D\u0442\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0442\u043E\u0447\u043D\u043E \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0442
      \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E \u044F \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u043B
      \u0432\u0441\u043B\u0443\u0445. \u041F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u043A\u0430\u043A \u044D\u0442\u043E \u0437\u0432\u0443\u0447\u0438\u0442.
      \n\u041C\u043E\u0436\u0435\u0442, \u0432\u0441\u0435\u043C\u0443 \u0435\u0441\u0442\u044C
      \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435.
      \u041D\u043E \u043A\u043E\u0433\u0434\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0448\u044C
      \u0436\u0434\u0430\u0442\u044C \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439
      \u0449\u0435\u043B\u0447\u043E\u043A \u043F\u0435\u0440\u0435\u0434 \u043E\u0442\u0432\u0435\u0442\u043E\u043C,
      \u043B\u044E\u0431\u043E\u0439 \u0437\u0432\u043E\u043D\u043E\u043A \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443 \u2014 \u043E\u0434\u0438\u043D
      \u043B\u0438 \u0442\u044B \u0432 \u044D\u0442\u043E\u043C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0435."
  - title: "\u0413\u043E\u043B\u043E\u0441\u0430 \u0432 \u0431\u0435\u043B\u043E\u043C
      \u0448\u0443\u043C\u0435"
    content: "\u0424\u0435\u043D\u043E\u043C\u0435\u043D \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u044F
      \u0433\u043E\u043B\u043E\u0441\u043E\u0432 \u0432 \u0431\u0435\u043B\u043E\u043C
      \u0448\u0443\u043C\u0435 \u043E\u0431\u044B\u0447\u043D\u043E \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u044E\u0442
      \u0441 \u043F\u0430\u0440\u0435\u0439\u0434\u043E\u043B\u0438\u0435\u0439 \u2014
      \u0441\u043A\u043B\u043E\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u043C\u043E\u0437\u0433\u0430
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0442\u044C \u043E\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u044B\u0435
      \u043F\u0430\u0442\u0442\u0435\u0440\u043D\u044B \u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445
      \u0441\u0438\u0433\u043D\u0430\u043B\u0430\u0445. \u042D\u0442\u043E \u0436\u0435
      \u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043B\u044E\u0434\u0435\u0439 \u0432\u0438\u0434\u0435\u0442\u044C \u043B\u0438\u0446\u0430
      \u0432 \u043F\u044F\u0442\u043D\u0430\u0445 \u0438\u043B\u0438 \u0444\u0438\u0433\u0443\u0440\u044B
      \u0432 \u043E\u0431\u043B\u0430\u043A\u0430\u0445. \u0412 \u0430\u043A\u0443\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0441\u0440\u0435\u0434\u0435 \u0440\u043E\u043B\u044C \u0442\u0430\u043A\u043E\u0433\u043E
      \u201C\u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0433\u043E \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u201D
      \u0438\u0433\u0440\u0430\u044E\u0442 \u0431\u0435\u043B\u044B\u0439 \u0448\u0443\u043C,
      \u0440\u0430\u0434\u0438\u043E\u043F\u043E\u043C\u0435\u0445\u0438, \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u044F,
      \u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0442\u0440\u0435\u0441\u043A
      \u0438 \u043D\u0438\u0437\u043A\u043E\u0430\u043C\u043F\u043B\u0438\u0442\u0443\u0434\u043D\u044B\u0435
      \u0444\u043E\u043D\u043E\u0432\u044B\u0435 \u043A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u044F.\n\n\u041D\u0430
      \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0435 \u0441\u0438\u043B\u044C\u043D\u043E
      \u0432\u043B\u0438\u044F\u044E\u0442 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435,
      \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u043E\u0441\u0442\u044C, \u0441\u0435\u043B\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0435
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0438 \u043F\u0440\u0430\u0439\u043C\u0438\u043D\u0433.
      \u0415\u0441\u043B\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0437\u0430\u0440\u0430\u043D\u0435\u0435
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E,
      \u0438\u043C\u044F \u0438\u043B\u0438 \u0438\u043D\u0442\u043E\u043D\u0430\u0446\u0438\u044E,
      \u0441\u043B\u0443\u0445\u043E\u0432\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u0441 \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E
      \u201C\u0441\u043E\u0431\u0435\u0440\u0451\u0442\u201D \u043D\u0443\u0436\u043D\u0443\u044E
      \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443 \u0438\u0437 \u043D\u0435\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0433\u043E
      \u0441\u0438\u0433\u043D\u0430\u043B\u0430. \u041F\u0440\u0438 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
      \u0432\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u043D\u0438\u0438 \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u0443\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0431\u044B\u043B\u043E."
  day2Notes:
  - title: 22.04.10 10:01
    content: "\u041D\u0443\u0436\u043D\u043E \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438 \u043C\u044B\u0441\u043B\u0438, \u044F \u0432\u0441\u0451
      \u0432\u0440\u0435\u043C\u044F \u043F\u0443\u0442\u0430\u044E\u0441\u044C \u0438
      \u0432\u0441\u0451 \u0437\u0430\u0431\u044B\u0432\u0430\u044E. \u0413\u043E\u043B\u043E\u0432\u0430
      \u043F\u043B\u044B\u0432\u0451\u0442...\u0432\u043D\u0443\u0442\u0440\u0438
      \u0442\u0430\u043A \u0436\u0430\u0440\u043A\u043E"
  - title: 23.04.10 10:24
    content: "\u041D\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u0439 \u0434\u043E\u043A\u0442\u043E\u0440\u0443
      \u041F! "
  - title: 23.04.10 14:37
    content: "\u041E\u043D\u0438 \u0445\u043E\u0442\u044F\u0442 \u043B\u0438\u0448\u0438\u0442\u044C
      \u043C\u0435\u043D\u044F \u043C\u043E\u0438\u0445 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439
      \u0432\u0438\u0434\u0435\u0442\u044C \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C.
      \u042F \u0431\u0443\u0434\u0443 \u0431\u043E\u0440\u043E\u0442\u044C\u0441\u044F.
      \u041D\u0435 \u0441\u0434\u0430\u0432\u0430\u0439\u0441\u044F, \u0410\u043D\u043D\u0430!"
  - title: 24.04.10 02:28
    content: "\u041D\u0418\u041A\u041E\u041C\u0423 \u041D\u0415 \u0414\u041E\u0412\u0415\u0420\u042F\u0419.
      \u041E\u041D\u0418 \u041F\u0420\u0418\u0414\u0423\u0422 \u0417\u0410 \u0422\u041E\u0411\u041E\u0419.
      \u041D\u0415 \u0412\u042B\u0425\u041E\u0414\u0418 \u0418\u0417 \u041A\u041E\u041C\u041D\u0410\u0422\u042B."
  day2Files:
  - title: DoNotDelete.txt
    content: "\u0410\u043D\u043D\u0430, \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0439.
      \u0420\u0430\u0434\u0438\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043F\u0440\u0430\u0432\u0434\u0443.
      \u041E\u043D\u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442 \u0441\u0432\u043E\u0439
      \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442 \u0443\u0436\u0435
      \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0434\u043E\u043B\u0433\u043E.
      \u042F \u0445\u043E\u0447\u0443 \u043F\u043E\u043C\u043E\u0447\u044C \u0442\u0435\u0431\u0435.
      \u0423 \u043C\u0435\u043D\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F
      \u043A \u0442\u0432\u043E\u0435\u043C\u0443 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0443
      \u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0444\u0430\u0439\u043B\u043E\u0432. \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
      \u0438 \u0442\u044B \u0432\u0441\u0451 \u043F\u043E\u0439\u043C\u0451\u0448\u044C.
      \u0412\u0440\u0435\u043C\u0435\u043D\u0438 \u043C\u0430\u043B\u043E. \u0411\u0443\u0434\u044C
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0430."
  day3BrowserTabs:
  - title: "\u0421\u043A\u0440\u044B\u0442\u044B\u0435 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F
      \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u044F"
    content: "\u0422\u0435\u043E\u0440\u0438\u0438 \u043E \u0441\u043A\u0440\u044B\u0442\u044B\u0445
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u0445
      \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u044F \u043E\u0431\u044B\u0447\u043D\u043E
      \u0441\u0442\u0440\u043E\u044F\u0442\u0441\u044F \u0432\u043E\u043A\u0440\u0443\u0433
      \u043E\u0434\u043D\u043E\u0439 \u0438\u0434\u0435\u0438: \u0435\u0441\u043B\u0438
      \u043C\u043E\u0436\u043D\u043E \u0438\u0437\u043C\u0435\u0440\u044F\u0442\u044C
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u043F\u0430\u043C\u044F\u0442\u044C
      \u0438 \u0440\u0435\u0430\u043A\u0446\u0438\u0438 \u043D\u0430 \u0441\u0442\u0438\u043C\u0443\u043B\u044B,
      \u0437\u043D\u0430\u0447\u0438\u0442 \u043C\u043E\u0436\u043D\u043E \u0438
      \u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
      \u0438\u043C\u0438 \u0432\u043D\u0435 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438.
      \u0412 \u0440\u0430\u0437\u043D\u044B\u0445 \u0432\u0435\u0440\u0441\u0438\u044F\u0445
      \u0442\u0430\u043A\u0438\u0445 \u0442\u0435\u043E\u0440\u0438\u0439 \u0444\u0438\u0433\u0443\u0440\u0438\u0440\u0443\u044E\u0442
      \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B,
      \u043E\u0431\u043E\u0440\u043E\u043D\u043D\u044B\u0435 \u043F\u043E\u0434\u0440\u044F\u0434\u0447\u0438\u043A\u0438,
      \u0444\u0430\u0440\u043C\u0430\u0446\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438 \u0438 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435
      \u0446\u0435\u043D\u0442\u0440\u044B, \u0438\u0437\u0443\u0447\u0430\u044E\u0449\u0438\u0435,
      \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0433\u043A\u043E
      \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0438\u043D\u0442\u0435\u0440\u043F\u0440\u0435\u0442\u0430\u0446\u0438\u044E
      \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u043F\u043E\u0434 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u0441\u0440\u0435\u0434\u044B.\n\n\u0427\u0430\u0449\u0435
      \u0432\u0441\u0435\u0433\u043E \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442\u0441\u044F
      \u0442\u0440\u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F:
      \u0441\u0435\u043D\u0441\u043E\u0440\u043D\u0430\u044F \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0430,
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u043E\u043D\u043D\u0430\u044F
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u044F \u0438
      \u0444\u0430\u0440\u043C\u0430\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u043C\u043E\u0434\u0443\u043B\u044F\u0446\u0438\u044F. \u0421\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043A\u0438
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0430 \u0441\u0447\u0438\u0442\u0430\u044E\u0442,
      \u0447\u0442\u043E \u0432 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438
      \u044D\u0442\u0438 \u043C\u0435\u0442\u043E\u0434\u044B \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
      \u043E\u0441\u043B\u0430\u0431\u0438\u0442\u044C \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0432 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C
      \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0438, \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C
      \u0432\u043D\u0443\u0448\u0430\u0435\u043C\u043E\u0441\u0442\u044C \u0438 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0435\u0433\u043E \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u044B\u043C \u043E\u0442
      \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430
      \u201C\u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E\u201D.
      \u0418\u043C\u0435\u043D\u043D\u043E \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0432 \u0442\u0430\u043A\u0438\u0445 \u0442\u0435\u043E\u0440\u0438\u044F\u0445
      \u0440\u044F\u0434\u043E\u043C \u0447\u0430\u0441\u0442\u043E \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u044B, \u0448\u0443\u043C,
      \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044F, \u043D\u0435\u0434\u043E\u0441\u044B\u043F
      \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0449\u0438\u0435\u0441\u044F
      \u0441\u0438\u0433\u043D\u0430\u043B\u044B."
  - title: "\u041F\u0440\u0438\u043D\u0443\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0433\u043E\u0441\u043F\u0438\u0442\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F"
    content: "\u041F\u0440\u0438\u043D\u0443\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0433\u043E\u0441\u043F\u0438\u0442\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F
      \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F\u0445, \u043A\u043E\u0433\u0434\u0430
      \u043F\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0439 \u0440\u0438\u0441\u043A
      \u0438 \u043E\u043D \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u043E\u0446\u0435\u043D\u0438\u0442\u044C \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0435\u0435.
      \u041E\u0431\u044B\u0447\u043D\u043E \u0440\u0435\u0447\u044C \u0438\u0434\u0451\u0442
      \u043E \u0441\u043B\u0443\u0447\u0430\u044F\u0445, \u043A\u043E\u0433\u0434\u0430
      \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0442\u0441\u044F \u043E\u0434\u043D\u043E
      \u0438\u043B\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0438\u0437
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0439:\n\n-
      \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0434\u043B\u044F \u0441\u0435\u0431\u044F\n-
      \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0434\u043B\u044F \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0445\n-
      \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u0430\u044F \u0434\u0435\u0437\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F
      \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F\n- \u0442\u044F\u0436\u0451\u043B\u043E\u0435
      \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0430
      \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E\n-
      \u043E\u0442\u043A\u0430\u0437 \u043E\u0442 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0439
      \u043F\u043E\u043C\u043E\u0449\u0438 \u043F\u0440\u0438 \u0431\u044B\u0441\u0442\u0440\u043E\u043C
      \u0443\u0445\u0443\u0434\u0448\u0435\u043D\u0438\u0438 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F\n\n\u0420\u0435\u0448\u0435\u043D\u0438\u0435
      \u043E \u0442\u0430\u043A\u043E\u0439 \u043C\u0435\u0440\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442
      \u043E\u0442 \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430,
      \u043A\u043B\u0438\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043E\u0446\u0435\u043D\u043A\u0438
      \u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438. "
  - title: "\u041F\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0439
      \u0447\u0435\u0440\u0435\u0437 \u0440\u0430\u0434\u0438\u043E"
    content: "\u041F\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0439
      \u043F\u043E \u0440\u0430\u0434\u0438\u043E \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043D\u044B\u0445
      \u0432\u043E\u043B\u043D, \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044F
      \u043A\u0430\u043A \u0433\u043E\u043B\u043E\u0441\u043E\u0432\u0443\u044E \u0441\u0432\u044F\u0437\u044C
      \u0447\u0435\u0440\u0435\u0437 \u0440\u0430\u0446\u0438\u0438 (PTT), \u0442\u0430\u043A
      \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u0434\u0430\u043D\u043D\u044B\u0445
      (RTTY, \u043F\u0430\u043A\u0435\u0442\u043D\u043E\u0435 \u0440\u0430\u0434\u0438\u043E,
      APRS). \u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u0442\u0435\u043A\u0441\u0442\u043E\u043C
      \u0438 \u0437\u0432\u0443\u043A\u043E\u043C, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
      \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D\u044B
      (VHF/UHF), \u043F\u0440\u0438\u0447\u0435\u043C \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0440\u0435\u043B\u044C\u0435\u0444\u0430
      \u0438 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F."
  day3Notes:
  - title: 24.04.10 10:02
    content: "\u042F \u043D\u0435 \u043F\u043E\u043C\u043D\u044E, \u043A\u0430\u043A
      \u043F\u0438\u0441\u0430\u043B\u0430 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0435
      \u0437\u0430\u043C\u0435\u0442\u043A\u0438...\u0432\u0441\u0451 \u0441\u043C\u0435\u0448\u0430\u043B\u043E\u0441\u044C."
  - title: 24.04.10 10:06
    content: "\u041E\u043D\u0438 \u0438\u0434\u0443\u0442 \u0437\u0430 \u043C\u043D\u043E\u0439"
  - title: 24.04.10 18:45
    content: "\u0413\u043E\u043B\u043E\u0441 \u0432 \u0440\u0430\u0434\u0438\u043E
      \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442
      \u043C\u043D\u0435. \u041C\u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u0443\u0442
      \u0441\u0431\u0435\u0436\u0430\u0442\u044C. \u042F \u0434\u043E\u043B\u0436\u043D\u0430
      \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044C \u043F\u0440\u0430\u0432\u0434\u0443. "
  - title: 24.04.10 03:39
    content: 2323847324732748564856324231293010562018495020175638392010384746542128495050685383847565020001827373645543829929283646474748389339384757565757575858585858585949
  day3Files:
  - title: PROJECT_ANNA.pdf
    content: "\u0412\u041D\u0423\u0422\u0420\u0415\u041D\u041D\u0418\u0419 \u0414\u041E\u041A\u0423\u041C\u0415\u041D\u0422\r\n\u0423\u0440\u043E\u0432\u0435\u043D\u044C
      \u0434\u043E\u0441\u0442\u0443\u043F\u0430: \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0439\r\n\u041E\u0431\u044A\u0435\u043A\u0442
      \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F: ANNA R.\r\n\u0421\u0442\u0430\u0442\u0443\u0441:
      \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435\r\n\u0426\u0435\u043B\u044C
      \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E \u044D\u0442\u0430\u043F\u0430
      \u2014 \u043E\u0446\u0435\u043D\u043A\u0430 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u0438
      \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u044F \u043E\u0431\u044A\u0435\u043A\u0442\u0430
      \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u043C\u0435\u0434\u0438\u043A\u0430\u043C\u0435\u043D\u0442\u043E\u0437\u043D\u043E\u0439
      \u043A\u043E\u0440\u0440\u0435\u043A\u0446\u0438\u0438, \u0441\u0435\u043D\u0441\u043E\u0440\u043D\u043E\u0439
      \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0449\u0438\u0445\u0441\u044F
      \u0441\u0438\u0433\u043D\u0430\u043B\u044C\u043D\u044B\u0445 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439.\r\n\u0417\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u044B
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438:\r\n-
      \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u0430\u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \r\n- \u0441\u043A\u043B\u043E\u043D\u043D\u043E\u0441\u0442\u044C \u043A \u0438\u043D\u0442\u0435\u0440\u043F\u0440\u0435\u0442\u0430\u0446\u0438\u0438
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445 \u0441\u0442\u0438\u043C\u0443\u043B\u043E\u0432
      \u043A\u0430\u043A \u043E\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u044B\u0445
      \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0439;\r\n- \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u0430\u044F
      \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043E\u0446\u0435\u043D\u043A\u0430
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F;\r\n-
      \u044D\u043F\u0438\u0437\u043E\u0434\u044B \u043E\u0442\u0447\u0443\u0436\u0434\u0435\u043D\u0438\u044F\r\n\u041F\u043E\u0441\u043B\u0435
      \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0434\u043E\u0437\u0438\u0440\u043E\u0432\u043A\u0438
      \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043E:\r\r"
  - title: Subject_4.pdf
    content: "\u041B\u0418\u0427\u041D\u041E\u0415 \u0414\u0415\u041B\u041E\r\n \u041A\u043E\u0434
      \u043E\u0431\u044A\u0435\u043A\u0442\u0430: [0004]\r\n \u0423\u0440\u043E\u0432\u0435\u043D\u044C
      \u0434\u043E\u0441\u0442\u0443\u043F\u0430: [\u0412\u041D\u0423\u0422\u0420\u0415\u041D\u041D\u0418\u0419]\r\n
      \u0421\u0442\u0430\u0442\u0443\u0441: [\u0410\u041A\u0422\u0418\u0412\u0415\u041D]\r\n1.
      \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F\r\n\u0418\u043C\u044F:
      [\u0410\u043D\u043D\u0430 \u0420\u0430\u0439\u0441]\r\n\u0412\u043E\u0437\u0440\u0430\u0441\u0442:
      [24]\r\n\u0414\u0430\u0442\u0430 \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F:
      [12.02.86]\r\n\u0410\u0434\u0440\u0435\u0441: [\u0423\u0414\u0410\u041B\u0415\u041D\u041E]\r\n\u0421\u0435\u043C\u0435\u0439\u043D\u043E\u0435
      \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435: [\u041D\u0435 \u0437\u0430\u043C\u0443\u0436\u0435\u043C]\r\n\u041C\u0435\u0441\u0442\u043E
      \u0440\u0430\u0431\u043E\u0442\u044B / \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F:
      [\u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442]"
  - title: call_record.txt
    content: "\u0410\u043D\u043D\u0430: \u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0437\u0430 \u043C\u043D\u043E\u0439 \u0441\u043B\u0435\u0434\u044F\u0442.\r\n\u0414\u043E\u043A\u0442\u043E\u0440
      \u041F: \u0410\u043D\u043D\u0430, \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F
      \u0443\u0441\u043F\u043E\u043A\u0438\u0442\u044C\u0441\u044F. \u0414\u0435\u043B\u0430\u0439
      \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0435 \u0432\u0434\u043E\u0445\u0438
      \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0435 \u0432\u044B\u0434\u043E\u0445\u0438,
      \u043A\u0430\u043A \u043C\u044B \u0434\u0435\u043B\u0430\u043B\u0438 \u043D\u0430
      \u043F\u0440\u0438\u0451\u043C\u0435, \u043F\u043E\u043C\u043D\u0438\u0448\u044C?\r\n\u0410\u043D\u043D\u0430:
      \u0418 \u0435\u0449\u0451 \u044D\u0442\u043E \u0440\u0430\u0434\u0438\u043E...
      \u041E\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0441\u043E
      \u043C\u043D\u043E\u0439. \u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u0440\u0430\u0437\u043D\u044B\u0435
      \u0432\u0435\u0449\u0438\r\n\u0414\u043E\u043A\u0442\u043E\u0440 \u041F: \u041D\u0435
      \u0441\u043B\u0443\u0448\u0430\u0439 \u0435\u0433\u043E. \u041F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F
